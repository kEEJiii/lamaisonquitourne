---
import ViewCount from './ViewCount.astro';
import { readingMinutes } from '../utils/articles';
const { article } = Astro.props;
const d = article.data;
const dateFr = d.pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'short', day: 'numeric' });
---
<li class="carte">
  <a href={`/articles/${article.id}/`}>
    <div class="meta">
      <span class="cat">{d.category}</span>
      <time datetime={d.pubDate.toISOString()}>{dateFr}</time>
    </div>
    <h3>{d.title}</h3>
    <p>{d.description}</p>
    <span class="carte-bottom"><span class="card-stats"><span>{readingMinutes(article.body)} min de lecture</span><ViewCount slug={article.id} /></span><span class="read-link">Lire l’article <span aria-hidden="true">↗</span></span></span>
  </a>
</li>
