---
interface Props {
  pratique: {
    difficulte: string;
    materiel: string[];
    etapes: string[];
    lien?: { href: string; texte: string };
    note?: string;
  };
}
const { pratique } = Astro.props;
---
<aside class="pratique" aria-labelledby="pratique-titre">
  <div class="pratique-heading">
    <h2 id="pratique-titre">Pour reproduire chez toi</h2>
    <p class="pratique-difficulte">{pratique.difficulte}</p>
  </div>
  <div class="pratique-grid">
    <div>
      <h3>Ce qu’il te faut</h3>
      <ul>{pratique.materiel.map(item => <li>{item}</li>)}</ul>
    </div>
    <div>
      <h3>Les étapes</h3>
      <ol>{pratique.etapes.map(item => <li>{item}</li>)}</ol>
    </div>
  </div>
  {pratique.note && <p class="pratique-note">{pratique.note}</p>}
  {pratique.lien && <a class="text-link" href={pratique.lien.href}>{pratique.lien.texte} <span aria-hidden="true">↓</span></a>}
</aside>

<style>
  .pratique { padding: 1.25rem; border: 1px solid var(--brume); border-top: 3px solid var(--etat); border-radius: 12px; background: var(--blanc); margin-bottom: 1.5rem; font-size: .9rem; }
  .pratique-heading { margin-bottom: 1rem; }
  .pratique h2 { margin: 0 0 .5rem; font-size: 1.25rem; }
  .pratique-difficulte { margin: 0; color: var(--ardoise); }
  .pratique-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: 1.25rem; }
  .pratique h3 { margin: 0 0 .6rem; font-size: 1rem; }
  .pratique ul, .pratique ol { margin: 0 0 0 1.2rem; }
  .pratique .pratique-note { border-top: 1px solid var(--brume); margin: 1rem 0 0; padding-top: .85rem; color: var(--ardoise); font-size: .85rem; }
  .pratique .text-link { margin-top: .5rem; }
  @media (max-width: 640px) { .pratique-grid { grid-template-columns: 1fr; gap: 1rem; } }
</style>
