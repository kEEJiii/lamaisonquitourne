---
import Base from './Base.astro';
import Chip from '../components/Chip.astro';
import ViewCount from '../components/ViewCount.astro';
import { getCollection } from 'astro:content';
import Carte from '../components/Carte.astro';
import { readingMinutes } from '../utils/articles';

const { article, headings = [] } = Astro.props;
const toc = headings.filter(h => h.depth === 2);
const others = (await getCollection('articles', ({ data }) => !data.draft)).filter(a => a.id !== article.id);
const related = others.sort((a, b) => Number(b.data.category === article.data.category) - Number(a.data.category === article.data.category) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 2);
const d = article.data;
const image = `/og/${article.id}.png`;
const articleUrl = new URL(`/articles/${article.id}/`, Astro.site).href;
const authorUrl = new URL('/a-propos/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: d.title,
  description: d.description,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  url: articleUrl,
  inLanguage: 'fr-FR',
  articleSection: d.category,
  datePublished: d.pubDate.toISOString(),
  ...(d.updatedDate ? { dateModified: d.updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: 'Alex', url: authorUrl },
  image: { '@type': 'ImageObject', url: new URL(image, Astro.site).href, width: 1200, height: 630 },
};
const dateFr = (v: Date) => v.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
const slugCat = d.category.toLowerCase()
  .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Base title={d.title} description={d.description} article={{ published: d.pubDate, modified: d.updatedDate }} image={image} imageAlt={d.title} structuredData={structuredData}>
  <article>
    <div class="wrap article-header">
      <a class="back-link" href="/articles/">← Tous les articles</a>
      <a class="cat" href={`/categories/${slugCat}/`}>{d.category}</a>
      <h1>{d.title}</h1>
      <p class="chapo">{d.description}</p>
      <div class="infos">
        <a href="/a-propos/" rel="author">Par Alex</a>
        <span>{readingMinutes(article.body)} min de lecture</span>
        <ViewCount slug={article.id} increment />
        <Chip etat={d.etat} label={d.etatLabel} />
        <time datetime={d.pubDate.toISOString()}>{dateFr(d.pubDate)}</time>
        {d.updatedDate && <span>Mis à jour le {dateFr(d.updatedDate)}</span>}
      </div>
    </div>
    <div class="wrap prose">
      {toc.length > 1 && <details class="article-toc"><summary>Dans cet article</summary><nav aria-label="Sommaire de l’article"><ol>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details>}
      <slot />
    </div>
  </article>
  {related.length > 0 && <section class="wrap-large related-section"><h2 class="section-titre">Pour continuer</h2><ul class="liste">{related.map(a => <Carte article={a} />)}</ul></section>}
</Base>
