---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Carte from '../../components/Carte.astro';
import { slugCategory } from '../../utils/articles';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(articles.map(a => a.data.category))];
---
<Base title="Tous les articles" description="L'ensemble des articles publiés sur La Maison qui Tourne.">
  <section class="wrap-large" style="padding-block:2.5rem">
    <h1 style="font-family:var(--font-titre);font-weight:800;font-size:2rem;letter-spacing:-.03em;margin-bottom:1.5rem">Tous les articles</h1>
    <nav class="topics" aria-label="Catégories d’articles">{categories.map(cat => <a href={`/categories/${slugCategory(cat)}/`}>{cat}</a>)}</nav>
    <ul class="liste">
      {articles.map(a => <Carte article={a} />)}
    </ul>
  </section>
</Base>
