---
import Base from '../layouts/Base.astro';
const pieces = [
  {
    id: 'salon', numero: '01', titre: 'Le salon', usage: 'Lumières, volets et confort',
    texte: 'Les lumières, les volets et la climatisation par zone sont accessibles dans l’app Maison. L’idée est de retrouver les commandes utiles sans parcourir tous les réglages de Home Assistant.',
    materiel: 'Modules d’éclairage Sonoff ZBMINIL2, volets et équipements de confort intégrés à Home Assistant.',
    lien: '/articles/quoi-exposer-app-maison-apple/', lecture: 'Ce que je garde dans l’app Maison',
  },
  {
    id: 'cuisine', numero: '02', titre: 'La cuisine', usage: 'Une information au bon moment',
    texte: 'L’éclairage de l’évier et de la hotte se pilote dans Maison. Le four et le lave-vaisselle Bosch remontent leurs informations dans Home Assistant. Pour la fin du lavage, un message est plus utile qu’une tuile supplémentaire.',
    materiel: 'Électroménager Bosch avec Home Connect et application Home Assistant Companion pour les notifications.',
    lien: '/articles/notifications-fin-lavage-home-assistant/', lecture: 'Préparer une notification de fin de lavage',
  },
  {
    id: 'buanderie', numero: '03', titre: 'La buanderie', usage: 'Ne plus oublier le linge',
    texte: 'Le lave-linge LG est intégré à Home Assistant. Le guide de notification part d’un besoin simple : savoir quand le linge est prêt. La réception et le déclenchement restent à vérifier sur plusieurs cycles.',
    materiel: 'Lave-linge LG, éclairage LED avec driver IKEA TRADFRI et téléphone avec Companion.',
    lien: '/articles/notifications-fin-lavage-home-assistant/', lecture: 'Construire et tester la notification',
  },
  {
    id: 'chambres', numero: '04', titre: 'Les chambres', usage: 'Des commandes faciles à retrouver',
    texte: 'Les volets et les capteurs d’ouverture sont regroupés par pièce dans l’app Maison. On peut agir sur un volet ou vérifier une fenêtre sans chercher parmi les batteries et les diagnostics.',
    materiel: 'Capteurs d’ouverture Aqara T1 en Zigbee, volets intégrés et pont HomeKit Bridge.',
    lien: '/articles/exposer-home-assistant-app-maison-apple/', lecture: 'Relier Home Assistant à l’app Maison',
  },
  {
    id: 'garage', numero: '05', titre: 'Le garage', usage: 'Présence et commande de l’eau',
    texte: 'Le détecteur de présence Sonoff SNZB-06P y est installé. La coupure générale d’eau est aussi accessible dans Maison. Son automatisation associe détection de fuite, commande de fermeture et vérification du résultat.',
    materiel: 'Détecteur de présence Sonoff SNZB-06P, module de coupure d’eau Tuya et détecteurs de fuite Aqara.',
    lien: '/articles/fuite-eau-coupure-home-assistant/', lecture: 'Comprendre la coupure d’eau et ses limites',
  },
  {
    id: 'jardin', numero: '06', titre: 'Le jardin', usage: 'Arrosage et tonte',
    texte: 'La vanne Sonoff SWV permet de piloter l’arrosage. Le robot tondeuse Navimow garde son application dédiée : pour consulter sa carte et ses zones, elle reste plus utile qu’un simple bouton dans Maison.',
    materiel: 'Vanne d’arrosage Sonoff SWV et robot tondeuse Navimow.',
    lien: '/materiel/#lextérieur', lecture: 'Retrouver le matériel du jardin',
  },
];
---
<Base title="Ma maison connectée, pièce par pièce" description="Du salon au jardin : les équipements et usages de ma maison avec Home Assistant, les guides pour les reproduire et les limites à connaître.">
  <section class="wrap-large maison-intro">
    <p class="eyebrow">Une visite par les usages</p>
    <h1>Ma maison connectée,<br />pièce par pièce.</h1>
    <p class="chapo">Une lumière, un volet, une machine qui termine son cycle. Voici comment Home Assistant trouve sa place dans la maison, et les guides pour faire pareil chez toi.</p>
    <nav class="topics" aria-label="Choisir une pièce">
      {pieces.map(piece => <a href={`#${piece.id}`}>{piece.titre} <span aria-hidden="true">↓</span></a>)}
    </nav>
    <p class="maison-repere">Cette visite rassemble les usages décrits sur le blog. Chaque guide précise ce qui est installé, ce qui reste à valider et les limites du montage.</p>
  </section>
  <section class="wrap-large maison-pieces" aria-label="Les pièces de la maison">
    <div class="pieces-grid">
      {pieces.map(piece => <article class="piece" id={piece.id}>
        <span class="piece-numero" aria-hidden="true">{piece.numero}</span>
        <h2>{piece.titre}</h2>
        <p class="piece-usage">{piece.usage}</p>
        <p>{piece.texte}</p>
        <p class="piece-materiel"><strong>Avec quoi ?</strong> {piece.materiel}</p>
        <a class="text-link" href={piece.lien}>{piece.lecture} <span aria-hidden="true">→</span></a>
      </article>)}
    </div>
  </section>
  <section class="wrap-large maison-suite">
    <div>
      <h2>Et ce qui relie le tout ?</h2>
      <p>Home Assistant sur Raspberry Pi, le réseau Zigbee pour une partie des appareils, et l’app Maison pour les gestes quotidiens. Alarmo s’appuie sur les capteurs pour gérer l’alarme.</p>
      <div class="maison-liens">
        <a class="text-link" href="/materiel/">Voir tout le matériel <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/articles/alarme-maison-sans-abonnement-alarmo/">Lire le retour sur Alarmo <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .maison-intro { padding-block: 2.5rem 1.5rem; }
  h1 { font-family: var(--font-titre); font-size: clamp(2rem, 5vw, 3rem); line-height: 1.08; letter-spacing: -.03em; margin-bottom: 1rem; }
  .chapo { max-width: 44rem; font-size: 1.1rem; color: var(--ardoise); }
  .maison-repere { max-width: 44rem; font-size: .9rem; color: var(--ardoise); }
  .topics { margin-bottom: 1rem; }
  .maison-pieces { padding-bottom: 2rem; }
  .pieces-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .piece { padding: 1.75rem; background: var(--blanc); border: 1px solid var(--brume); border-radius: 14px; display: flex; flex-direction: column; align-items: flex-start; }
  .piece-numero { font-family: var(--font-code); color: var(--accent); font-size: .8rem; margin-bottom: .6rem; }
  h2 { font-family: var(--font-titre); font-size: 1.6rem; line-height: 1.2; margin-bottom: .4rem; }
  .piece p { margin-bottom: 1rem; font-size: .95rem; color: var(--ardoise); }
  .piece .piece-usage { font-weight: 600; color: var(--encre); }
  .piece .piece-materiel { padding-top: 1rem; border-top: 1px solid var(--brume); font-size: .85rem; }
  .piece .text-link { margin-top: auto; }
  .maison-suite { padding-bottom: 3rem; }
  .maison-suite > div { border-left: 3px solid var(--etat); padding: .5rem 0 .5rem 1.25rem; }
  .maison-suite p { max-width: 44rem; margin-top: .75rem; color: var(--ardoise); }
  .maison-liens { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: .5rem; }
  @media (max-width: 640px) { .pieces-grid { grid-template-columns: 1fr; } .piece { padding: 1.25rem; } .maison-intro { padding-top: 1.75rem; } }
</style>
