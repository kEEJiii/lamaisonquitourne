{
  "name": "lamaisonquitourne",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/views/*"
    ]
  },
  "main": "src/server/worker.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "ARTICLE_VIEWS",
        "class_name": "ArticleViews"
      }
    ]
  },
  "migrations": [
    {
      "tag": "article-views-v1",
      "new_sqlite_classes": [
        "ArticleViews"
      ]
    }
  ]
}
